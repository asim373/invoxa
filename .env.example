POSTGRES_DB=document_analyzer
POSTGRES_USER=document_analyzer
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=5173
DATABASE_URL=postgresql://document_analyzer:change-me-for-local-development@postgres:5432/document_analyzer
REDIS_URL=redis://redis:6379/0
QUEUE_RECONCILIATION_INTERVAL_SECONDS=30
MAX_PDF_PAGES=100
MAX_IMAGE_PIXELS=50000000
OCR_TIMEOUT_SECONDS=120
LOG_LEVEL=INFO
APP_ENVIRONMENT=development
AUTH_SECRET_KEY=change-me-before-production-use-a-random-secret
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
RATE_LIMIT_ENABLED=true
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=20
FORGOT_PASSWORD_RATE_LIMIT=5
FORGOT_PASSWORD_RATE_WINDOW_SECONDS=3600
RESET_PASSWORD_RATE_LIMIT=10
RESET_PASSWORD_RATE_WINDOW_SECONDS=900
FRONTEND_BASE_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
PASSWORD_RESET_DEV_OUTBOX_PATH=storage/password-reset-outbox
